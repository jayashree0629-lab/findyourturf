# Backend URL (Render). Leave blank for local development (http://localhost:5000).
VITE_API_URL=

# Google OAuth "Web application" client id. Enables "Continue with Google" on
# the sign-in screen (the backend also needs GOOGLE_CLIENT_ID).
VITE_GOOGLE_CLIENT_ID=

# Shown on the Help center and footer.
VITE_SUPPORT_PHONE=
VITE_SUPPORT_EMAIL=
