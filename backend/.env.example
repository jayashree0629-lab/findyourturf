# Copy this file to `.env` and fill in real values. Never commit the real `.env`.

# --- Required ---

# MongoDB Atlas connection string (include the username/password/db name in
# the string itself — mongoose only reads this one variable).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority

# Secret used to sign admin JWTs. Use a long random string.
# On Render this can be left unset if the service's render.yaml has
# `generateValue: true` for it, which makes Render generate one automatically.
JWT_SECRET=replace-with-a-long-random-string

# --- Optional ---

# Port the server listens on. Render sets this automatically — only needed
# for local development if you don't want the default of 5000.
PORT=5000

# Comma-separated list of extra allowed CORS origins (production frontend
# URLs, no trailing slash). localhost/127.0.0.1/192.168.x.x on any port are
# always allowed automatically — you only need to list deployed frontends.
# Current production value (set this in the Render dashboard — it is NOT
# read from this file or from render.yaml, which marks it `sync: false`):
CLIENT_ORIGINS=https://admin-pi-two-89.vercel.app,https://turf-five-chi.vercel.app

# Overrides for the default seeded admin account (admin@turfhub.com / admin@123
# is used if these are not set).
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
# Set to "true" to reset the seeded admin's password to SEED_ADMIN_PASSWORD
# even if that admin account already exists.
SEED_ADMIN_RESET=
